# ---- Client environment variables ----

# Base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- Firebase Web SDK (Phase 2) ----
# Firebase Console > Project Settings > General > "Your apps" > Web app > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase App Check (bot / abuse protection) ----
# reCAPTCHA Enterprise key ID: create a score-based (v3) key in Google Cloud
# Console > reCAPTCHA, then register the web app in Firebase Console > App Check
# with the reCAPTCHA Enterprise provider using that key ID. Leave BLANK to
# disable App Check locally (the client skips init and the API stays reachable).
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ---- Google Maps Places (job location autocomplete) ----
# Google Cloud Console > APIs & Services > Credentials. Enable "Places API"
# and "Maps JavaScript API", then restrict the key to your site's HTTP
# referrers. Without this set, the location field falls back to plain
# free-text tag entry (no autocomplete).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
