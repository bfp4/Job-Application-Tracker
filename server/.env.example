# ---- Server environment variables ----

# PostgreSQL connection string used by Prisma.
#
# Default is a LOCAL database — dev work must never run against production.
# Match production's major version (PostgreSQL 18) so migrations behave the
# same locally as they do on RDS. One-time setup:
#
#   psql -U postgres -p 5433 \
#     -c "CREATE ROLE jobtracker LOGIN PASSWORD 'jobtracker_local_dev'" \
#     -c "CREATE DATABASE jobtracker_dev OWNER jobtracker"
#   npx prisma migrate deploy
#
# (two -c flags: CREATE DATABASE cannot run inside a transaction block)
DATABASE_URL="postgresql://jobtracker:jobtracker_local_dev@localhost:5433/jobtracker_dev?schema=public"

# To reach PRODUCTION instead — live user data, so be deliberate — start
# ./infra/tunnel.sh in another terminal and swap in the RDS master credentials
# against localhost:15433. RDS is private; there is no direct route and no SSH.
# DATABASE_URL="postgresql://<user>:<password>@localhost:15433/<dbname>?schema=public"

# Port the Express server listens on.
PORT=5000

# Comma-separated list of allowed origins for CORS (frontend URL).
CORS_ORIGIN="http://localhost:3000"

# ---- Firebase Admin (Phase 2) ----
# Firebase Console > Project Settings > Service accounts > "Generate new private key".
# The downloaded JSON contains project_id, client_email, and private_key.
# Keep the private key on a single line and preserve the literal "\n" sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Firebase App Check enforcement ----
# When "true", the API rejects requests without a valid App Check token
# (X-Firebase-AppCheck header). Leave unset/false until App Check is registered
# in the Firebase console AND the web client is sending tokens, or you'll lock
# out all clients. Enable last, after verifying tokens flow end-to-end.
APP_CHECK_ENFORCED=false

# ---- AWS S3 file uploads (Phase 5) ----
# Used to mint pre-signed URLs so the frontend can upload/download files directly.
# The access keys are for LOCAL DEV ONLY: on EC2 leave both unset and the SDK
# resolves credentials from the instance role instead (no static keys on the box).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ---- Anthropic Claude API (AI resume tips) ----
# Create a key at https://console.anthropic.com/ > API Keys.
# Used by the resume-tips agent to analyze the stored resume against a job
# posting and produce structured advice.
ANTHROPIC_API_KEY=
