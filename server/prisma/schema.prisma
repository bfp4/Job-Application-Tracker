generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The career field a user's AI output is specialized for. Drives the
// field-specific guidance in the tailored-resume, cover-letter, resume-tips,
// LinkedIn-note, and application-answer prompts. KEEP IN SYNC with
// CAREER_SPECIALIZATION_LABELS in server/src/lib/careerSpecializations.ts.
enum CareerSpecialization {
  GENERAL
  SOFTWARE_ENGINEERING
  FINANCE
  CONSULTING
  MARKETING
  SALES
  HEALTHCARE
  DESIGN
  DATA_ANALYTICS
}

// A user's access level. BASIC is capped at 10 AI calls/day (see
// aiCallsUsedToday); PREMIUM and ADMIN are unlimited. ADMIN is never settable
// via the API — only by direct DB edit — so the admin UI only ever toggles
// BASIC <-> PREMIUM.
enum UserTier {
  BASIC
  PREMIUM
  ADMIN
}

enum PremiumRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model User {
  id                   String               @id @default(cuid())
  firebaseUid          String               @unique
  email                String               @unique
  createdAt            DateTime             @default(now())
  // The career field the user wants their AI output specialized for (see enum above).
  careerSpecialization CareerSpecialization @default(GENERAL)
  tier                 UserTier             @default(BASIC)
  // Opted out of the daily reminder digest. CAN-SPAM requires the opt-out to
  // be honored on every send, so the Lambda's two queries filter on it rather
  // than the handler skipping addresses after the fact — an unsubscribed user
  // must never be assembled into a digest at all.
  emailOptOut          Boolean              @default(false)
  // Bearer token for the unsubscribe link in each digest footer. Random per
  // user (uuid v4, 122 bits) because the link is clicked from an email client
  // with no session: possession of the token is the entire authorization to
  // flip emailOptOut, so it must not be derivable from the id or the address.
  // Deleting a row and re-signing up mints a fresh one, which is the intended
  // rotation path.
  unsubscribeToken     String               @unique @default(dbgenerated("(gen_random_uuid())::text"))
  // Successful AI calls made on aiCallsDate. Reset to 0 whenever a request
  // comes in on a later UTC day. Only meaningful for BASIC (PREMIUM/ADMIN
  // never check or increment it).
  aiCallsUsedToday     Int                  @default(0)
  aiCallsDate          DateTime?
  baseResumes          BaseResume[]
  applications         Application[]
  jobPostings          JobPosting[]
  premiumRequests      PremiumRequest[]
}

// A basic user's ask to be upgraded to PREMIUM, submitted from Settings and
// reviewed by an admin on the admin page.
//
// DB-only constraint not expressible here: a partial unique index enforces
// at most one PENDING row per userId (migration
// 20260802000000_premium_request_pending_unique) — Prisma's schema DSL can't
// declare a filtered/partial index, so it only exists in that migration.
//
// WARNING: because this file doesn't mention that index, `prisma migrate dev`
// reads it as drift and will put a DROP INDEX
// "PremiumRequest_userId_pending_unique" in the *next* migration it generates,
// whatever that migration was actually for. Delete that line before applying —
// dropping it turns the P2002 handler in routes/user.ts into dead code and
// lets a double-submit create two pending requests. src/lib/migrations.test.ts
// fails if a migration ever leaves the index dropped.
model PremiumRequest {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  message    String
  status     PremiumRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([status])
}

model BaseResume {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  pdfS3Key         String
  markdownS3Key    String
  createdAt        DateTime          @default(now())
  resumeAnalyses   ResumeAnalysis[]
  tailoredResumes  TailoredResume[]
  coverLetters     CoverLetter[]

  @@index([userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  jobPostings JobPosting[]
}

// Postings are scoped to the user who entered them — the same jobUrl entered
// by two users produces two independent rows, so no user can rewrite what
// another user sees.
model JobPosting {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  title        String
  location     String[]      @default([])
  salary       String?
  jobUrl       String
  description  String?
  postedDate   DateTime?
  fetchedAt    DateTime      @default(now())
  applications Application[]

  @@unique([userId, jobUrl])
  @@index([userId])
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
  PHONE_SCREEN
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  jobPostingId String
  jobPosting   JobPosting        @relation(fields: [jobPostingId], references: [id])
  status       ApplicationStatus @default(NOT_APPLIED)
  notes        String?
  // Where the user found the job (LinkedIn, referral, ...). Free text.
  source       String?
  appliedDate  DateTime?
  // Last time the reminder Lambda nudged the user to submit this application.
  // Dedupes within a day (same rule as FollowUp.reminderSentAt) so a retried
  // invocation can't re-send a nudge the user already got today; the next
  // day's run nudges again until the application leaves NOT_APPLIED.
  nudgeSentAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  followUps      FollowUp[]
  resumeAnalysis ResumeAnalysis?
  tailoredResume TailoredResume?
  coverLetter    CoverLetter?
  questions      ApplicationQuestion[]
  contacts       Contact[]
  timelineEntries TimelineEntry[]

  @@unique([userId, jobPostingId])
  @@index([userId])
  // The daily reminder Lambda scans for status = NOT_APPLIED across all users,
  // skipping those already nudged today.
  @@index([status, nudgeSentAt])
}

// One row per stage an application has occupied. Created automatically
// whenever PATCH /api/applications/:id changes `status`, and editable
// (note/occurredAt) or addable by hand afterward — e.g. to log a phone-screen
// or interview note, or backfill history from before this model existed.
model TimelineEntry {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  // When this stage actually happened, as a calendar date stored at UTC
  // midnight (like appliedDate/followUpDate) — editable, so the user can
  // correct or backfill it. Both write paths set this explicitly from the
  // client's calendar day; the now() default is a floor for direct API
  // clients, not something application code should fall through to, since a
  // real instant renders as the next day west of UTC.
  occurredAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([applicationId])
}

// Where the user is in the LinkedIn networking flow with a contact.
enum LinkedinStatus {
  NONE // No LinkedIn action taken yet.
  CONNECTION_SENT // Connection request sent, not yet accepted.
  CONNECTED // Connection accepted — now 1st-degree.
  MESSAGING // Actively exchanging messages.
}

// A person the user is in contact with about this application
// (recruiter, hiring manager, referral, ...).
model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  position      String?
  linkedinUrl   String?
  phone         String?
  email         String?
  notes         String?
  // Where the user stands in the LinkedIn networking flow with this person.
  linkedinStatus LinkedinStatus @default(NONE)
  // The last AI-drafted (and possibly hand-edited) LinkedIn connection note.
  // Capped at 300 chars to match LinkedIn's connection-request limit.
  connectMessage String?
  // Hash of the inputs the note was drafted from (see
  // connectMessageFingerprint). The generate route refuses while it still
  // matches, so an unchanged contact can't re-bill the model.
  connectMessageHash String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

// A question asked on the job application form (e.g. "What project are you
// most proud of?"), with the user's answer. The answer can be AI-drafted from
// the resume + posting and then edited by hand — the row doesn't distinguish.
model ApplicationQuestion {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String
  answer        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

// One saved resume-tips analysis per application. baseResumeId and
// jobPostingHash record what the analysis was generated from, so a re-run is
// only allowed once the resume or the posting's content has actually changed.
model ResumeAnalysis {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResumeId   String
  baseResume     BaseResume  @relation(fields: [baseResumeId], references: [id])
  jobPostingHash String
  content        Json
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// One saved tailored-resume draft per application, generated by rephrasing and
// reordering the base resume for this posting (never inventing facts).
// baseResumeId + jobPostingHash record what it was generated from — same
// staleness rule as ResumeAnalysis. `edited` flips true once the user hand-
// edits the draft, so a regenerate can warn before discarding their changes.
model TailoredResume {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResumeId   String
  baseResume     BaseResume  @relation(fields: [baseResumeId], references: [id])
  jobPostingHash String
  content        Json
  edited         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// One saved cover-letter draft per application, written from the base resume
// and the posting. Same baseResumeId + jobPostingHash staleness rule and same
// `edited` guard as TailoredResume.
model CoverLetter {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseResumeId   String
  baseResume     BaseResume  @relation(fields: [baseResumeId], references: [id])
  jobPostingHash String
  content        Json
  edited         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// NOTE: lambda/src/db.ts queries this model (and Application/User/JobPosting/
// Company) with raw SQL — renames here must be mirrored there by hand.
model FollowUp {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  followUpDate   DateTime
  note           String?
  completed      Boolean     @default(false)
  // Last time the reminder Lambda mentioned this follow-up in a digest.
  // Dedupes within a day; the digest re-mentions it each day from 3 days
  // before the due date through the day itself.
  reminderSentAt DateTime?

  @@index([applicationId])
  // The daily reminder Lambda queries a 4-day followUpDate window across all
  // users; without this it sequential-scans the whole table.
  @@index([followUpDate])
}
